#pragma experiment("TRAITS")
import is_atomic_part
import has_part_picked
import has_designator_prefix

component C8598_package:
    """CJ B5819W SL (LCSC C8598). Generated by scripts/parts/import_lcsc.py."""
    trait is_atomic_part<manufacturer="CJ", partnumber="B5819W SL", footprint="SOD-123_L2.7-W1.6-LS3.7-RD-1.kicad_mod", symbol="B5819W_C8598.kicad_sym", model="SOD-123_L2.7-W1.6-LS3.7-RD-1.step">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C8598", manufacturer="CJ", partno="B5819W SL">
    trait has_designator_prefix<prefix="D">

    signal pos ~ pin 2
    signal neg ~ pin 1
