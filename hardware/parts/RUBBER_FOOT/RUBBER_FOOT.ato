#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix

component RUBBER_FOOT_package:
    """Rubber foot position, 6 mm, at least 3.5 mm tall (hand-fitted). Generated by scripts/parts/custom_parts.py; not in the JLC BOM."""
    trait is_atomic_part<manufacturer="none", partnumber="RUBBER_FOOT", footprint="RUBBER_FOOT.kicad_mod", symbol="RUBBER_FOOT.kicad_sym">
    trait has_designator_prefix<prefix="MK">

