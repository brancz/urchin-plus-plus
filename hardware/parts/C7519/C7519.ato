#pragma experiment("TRAITS")
import is_atomic_part
import has_part_picked
import has_designator_prefix

component C7519_package:
    """ST USBLC6-2SC6 (LCSC C7519). Generated by scripts/parts/import_lcsc.py."""
    trait is_atomic_part<manufacturer="ST", partnumber="USBLC6-2SC6", footprint="SOT-23-6_L2.9-W1.6-P0.95-LS2.8-BL.kicad_mod", symbol="USBLC6-2SC6.kicad_sym", model="SOT-23-6_L2.9-W1.6-H1.5-LS2.8-P0.95.step">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C7519", manufacturer="ST", partno="USBLC6-2SC6">
    trait has_designator_prefix<prefix="D">

    signal GND ~ pin 2
    signal IO1 ~ pin 1
    IO1 ~ pin 6
    signal IO2 ~ pin 3
    IO2 ~ pin 4
    signal VBUS ~ pin 5
