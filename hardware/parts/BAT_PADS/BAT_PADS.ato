#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix

component BAT_PADS_package:
    """Battery wire pads (hand-soldered). Generated by scripts/parts/custom_parts.py; not in the JLC BOM."""
    trait is_atomic_part<manufacturer="none", partnumber="BAT_PADS", footprint="BAT_PADS.kicad_mod", symbol="BAT_PADS.kicad_sym">
    trait has_designator_prefix<prefix="BT">

    signal POS ~ pin 1
    signal NEG ~ pin 2
