#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix

component PUCK_package:
    """Tenting-puck mount of the original Urchin. Generated by scripts/geometry/mechanical_parts.py; not in the JLC BOM."""
    trait is_atomic_part<manufacturer="none", partnumber="PUCK", footprint="Tenting_Puck2_no_pads.kicad_mod", symbol="PUCK.kicad_sym">
    trait has_designator_prefix<prefix="H">
