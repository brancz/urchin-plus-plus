#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix

component SWD_PADS_package:
    """SWD pads for the one-time bootloader flash. Generated by scripts/parts/custom_parts.py; not in the JLC BOM."""
    trait is_atomic_part<manufacturer="none", partnumber="SWD_PADS", footprint="SWD_PADS.kicad_mod", symbol="SWD_PADS.kicad_sym">
    trait has_designator_prefix<prefix="TP">

    signal VDD ~ pin 1
    signal SWDIO ~ pin 2
    signal SWDCLK ~ pin 3
    signal RESET ~ pin 4
    signal GND ~ pin 5
