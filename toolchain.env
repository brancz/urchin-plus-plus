# Pinned toolchain (CLAUDE.md rule 4). Single source for CI, scripts/checks/toolchain.sh
# and the KiCad guardrails. Human-readable table and install steps: docs/SETUP.md.
KICAD_VERSION=9.0.9
# Official KiCad image for CI, pinned by digest (.github/workflows/ci.yml must match).
KICAD_IMAGE=kicad/kicad:9.0.9@sha256:e638b79b0321f29395a5b783e94bb9f3c73303e8da15da27b8f5cb4b67a37729
# Newest file formats the pipeline accepts (KiCad 9.0; scripts/checks/kicad_guardrails.py).
# MAX_PCB_FORMAT covers .kicad_pcb and .kicad_mod, MAX_SYM_FORMAT covers .kicad_sym.
MAX_PCB_FORMAT=20241229
MAX_SYM_FORMAT=20241209
ATOPILE_VERSION=0.15.7
ATOPILE_PYTHON=3.14
UV_VERSION=0.13.1
KIKIT_VERSION=1.8.1
FREEROUTING_VERSION=2.5.0
FREEROUTING_SHA256=f6f51bb02245e8e717f9359bd260cc9c5c0b1bc0acc8b7cb2cd5b8ffeb5de3c7
JAVA_MIN_MAJOR=25
EASYEDA2KICAD_VERSION=1.0.1
PYOCD_VERSION=0.45.1
# Firmware (phase 8). ZMK, Zephyr and zmk-rgbled-widget are pinned in firmware/config/west.yml.
# ZMK's build image (Zephyr SDK 0.16.9), multi-arch index digest of zmkfirmware/zmk-build-arm:4.1.
ZMK_BUILD_IMAGE=zmkfirmware/zmk-build-arm:4.1@sha256:edb1c953438c6f720ddb79c3762f3972013b7fbbaf4fff3592fc869983e7afc5
ADAFRUIT_BOOTLOADER_VERSION=0.11.0
ADAFRUIT_BOOTLOADER_COMMIT=c67f0bcf0fa8e841426335b1bbde91cda6ca1f50
INTELHEX_VERSION=2.3.0
# The pure-Python wheel from PyPI (the build image has no pip); its SHA-256:
INTELHEX_SHA256=87cc5225657524ec6361354be928adfd56bcf2a3dcc646c40f8f094c39c07db4
# macOS menu-bar app (menubar/): Swift from Apple's Command Line Tools locally, the same
# release's Xcode in CI (/Applications/Xcode_<XCODE_VERSION>.app on the macos-26 runner).
XCODE_VERSION=26.4.1
SWIFT_VERSION=6.3.1
