# Pinned toolchain (CLAUDE.md rule 4). Single source for CI, scripts/checks/toolchain.sh
# and the KiCad guardrails. Human-readable table and install steps: docs/SETUP.md.
KICAD_VERSION=9.0.9
# Official KiCad image for CI, pinned by digest (.github/workflows/ci.yml must match).
KICAD_IMAGE=kicad/kicad:9.0.9@sha256:e638b79b0321f29395a5b783e94bb9f3c73303e8da15da27b8f5cb4b67a37729
# Newest file formats the pipeline accepts (KiCad 9.0; scripts/checks/kicad_guardrails.py).
# MAX_PCB_FORMAT covers .kicad_pcb and .kicad_mod, MAX_SYM_FORMAT covers .kicad_sym.
MAX_PCB_FORMAT=20241229
MAX_SYM_FORMAT=20241209
ATOPILE_VERSION=0.15.7
ATOPILE_PYTHON=3.14
UV_VERSION=0.13.1
KIKIT_VERSION=1.8.1
FREEROUTING_VERSION=2.5.0
FREEROUTING_SHA256=f6f51bb02245e8e717f9359bd260cc9c5c0b1bc0acc8b7cb2cd5b8ffeb5de3c7
JAVA_MIN_MAJOR=25
EASYEDA2KICAD_VERSION=1.0.1
PYOCD_VERSION=0.45.1
