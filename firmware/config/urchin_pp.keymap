/*
 * urchin++ keymap: ported from brancz/urchin-zmk-firmware (config/urchin.keymap,
 * commit 5bfccc6), which is based on duckyb's Urchin keymap.
 * Copyright (c) 2020 duckyb
 *
 * SPDX-License-Identifier: MIT
 *
 * Positions are the Urchin's: three rows of 5 + 5 keys (0-29), then the thumbs left outer,
 * left inner, right inner, right outer (30-33). Added for urchin++: &ind_bat / &ind_con on
 * the settings layer (zmk-rgbled-widget: show battery level / connection state on the LED).
 */

#include <behaviors.dtsi>
#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer definitions
#define BASE 0
#define SYM 1
#define NAV 2
#define SETTINGS 3
// -----------------

&sk {
	// don't release mods on other mods presses
	ignore-modifiers;
};


/ {
	behaviors {
		// Enables holding the first mod-tap key
		// by performing a tap-release-hold sequence.
		// To use it: "&qt KEYCODE1 KEYCODE2"
		qt: quick_tap {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <300>;
			quick-tap-ms = <300>;
			bindings = <&kp>, <&kp>;
		};

        comma_dot: comma_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Macro to activate both RGUI and NAV layer
        mo_rgui_nav: mo_rgui_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RGUI &mo NAV>,
                      <&macro_pause_for_release>,
                      <&macro_release &kp RGUI &mo NAV>;
        };

        // Custom mod-tap that combines RGUI with layer access
        rgui_nav_kp: rgui_nav_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo_rgui_nav>, <&kp>;
        };

        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&to>;
        };
	};

	combos {
		compatible = "zmk,combos";
		// both left thumb keys
		combo_settings {
			timeout-ms = <200>;
			key-positions = <30 31>;
			bindings = <&mo SETTINGS>;
		};
	};

    macros {
        sp: sp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_tap &to BASE>
                ;
        };

        gui_layer: gui_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release &to BASE &kp LGUI>
                ;
        };
    };

	keymap {
		compatible = "zmk,keymap";
		// Base alpha layer
		default_layer {
			bindings = <
			&kp Q &kp W &kp F &kp P &kp G                           &kp J &kp L  &kp U      &kp Y   &kp BSPC
			&kp A &kp R &kp S &kp T &kp D                           &kp H &kp N  &kp E      &kp I   &kp O
			&rgui_nav_kp 0 Z &kp X &kp C &kp V &kp B                &kp K &kp M  &comma_dot &kp SEMICOLON &kp SLASH
					          &qt LSHIFT TAB   &lth LCTRL SYM       &kp SPACE &qt RSHIFT ENTER
			>;
		};

		// Numbers and high frequency symbols
        sym_layer {
			bindings = <
			&sp N1 &sp N2 &sp N3 &sp N4 &sp N5                         &sp N6 &sp N7 &sp N8 &sp N9 &sp N0
			&sp GRAVE &sp MINUS &sp LBKT &sp RBKT &sp BSLH             &sp EQUAL &sp SQT &sp LPAR &sp RPAR &sp PIPE
			&sp TILDE &sp UNDER &sp LBRC &sp RBRC &sp HASH             &sp PLUS &sp DQT &sp LT &sp GT &sp AMPS
                                         &kp LSHIFT &sp ESC            &to NAV &kp RSHIFT
			>;
		};

        nav_layer {
			bindings = <
			&kp N1 &kp N2 &kp N3 &kp N4 &kp N5               &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
			&kp Z &kp R &kp S &kp T &trans                   &kp TAB &kp LEFT &kp UP &kp DOWN &kp RIGHT
			&trans &kp X &kp C &kp V &trans                  &trans &trans &trans &trans &trans
                               &kp LSHIFT &to BASE               &to BASE &kp RSHIFT
			>;
		};

		// Used to change the keyboard's settings.
		settings_layer {
				bindings = <
				&bootloader &trans &trans &bt BT_CLR &bt BT_SEL 0         &bt BT_SEL 3 &trans &trans &trans &bootloader
				&ind_bat &ind_con &trans &trans      &bt BT_SEL 1 			    &bt BT_SEL 4 &trans &trans &trans &trans
				&studio_unlock &trans &trans &trans &bt BT_SEL 2           &bt BT_SEL 5 &trans &trans &trans &studio_unlock
										         &trans &trans            &trans &trans
				>;
		};
	};
};
