# A split peripheral talks to the left half over BLE; USB is for charging and the bootloader.
CONFIG_ZMK_BLE=y

CONFIG_ARM_MPU=y
CONFIG_GPIO=y

# The E73 has no 32.768 kHz crystal (its XL1/XL2 pins carry keys and the LED): the low
# frequency clock is the internal RC oscillator, calibrated by Zephyr.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# UF2 for the Adafruit nRF52 bootloader (nRF52840 family 0xADA52840, the default)
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_USE_DT_CODE_PARTITION=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
