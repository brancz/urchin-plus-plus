#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix

component DOCK_CONTACTS_package:
    """Dock contacts under a half's pogo pins: GND / 5V / GND (bare ENIG). Generated by scripts/parts/custom_parts.py; not in the JLC BOM."""
    trait is_atomic_part<manufacturer="none", partnumber="DOCK_CONTACTS", footprint="DOCK_CONTACTS.kicad_mod", symbol="DOCK_CONTACTS.kicad_sym">
    trait has_designator_prefix<prefix="TP">

    signal GND ~ pin 1
    signal V5 ~ pin 2
    GND ~ pin 3
